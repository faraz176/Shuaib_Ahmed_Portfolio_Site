  "labs/rhel-administration/links.png": {
    "title": "RHEL / symbolic and hard links",
    "lines": [
      "[shuaib@linux-project1 ~/project1_files]$ ln -s /etc/hosts hosts_link",
      "[shuaib@linux-project1 ~/project1_files]$ ls -l hosts_link",
      "lrwxrwxrwx. 1 shuaib shuaib 10 Nov 3 05:01 hosts_link -> /etc/hosts",
      "[shuaib@linux-project1 ~/project1_files]$ cat /proc/sys/fs/protected_hardlinks",
      "1",
      "[shuaib@linux-project1 ~/project1_files]$ sudo ln /etc/hosts hosts_hardlink",
      "[shuaib@linux-project1 ~/project1_files]$ ls -li /etc/hosts hosts_hardlink hosts_link",
      "67243273 -rw-r--r--. 2 root root 384 Nov 29 2023 /etc/hosts",
      "67243273 -rw-r--r--. 2 root root 384 Nov 29 2023 hosts_hardlink",
      "2822905 lrwxrwxrwx. 1 shuaib shuaib 10 Nov 3 05:01 hosts_link -> /etc/hosts",
      "[shuaib@linux-project1 ~/project1_files]$ stat -c '%n -> inode %i, %h hard links' /etc/hosts hosts_hardlink",
      "/etc/hosts -> inode 67243273, 2 hard links",
      "hosts_hardlink -> inode 67243273, 2 hard links",
      "[shuaib@linux-project1 ~/project1_files]$ head -n 2 hosts_link",
      "# Loopback entries; do not change.",
      "# For historical reasons, localhost precedes localhost.localdomain:"
    ],
    "sha256": "cf433704a8abbf0dc2e7c8f0e13893dcbeedf0abbf9c95ddc6b4cfc31ed6869a"
  },
  "labs/rhel-administration/permissions.png": {
    "title": "RHEL / ownership and permissions",
    "lines": [
      "[shuaib@linux-project1 ~/project1_files]$ touch permissions_test.txt group_test.txt",
      "[shuaib@linux-project1 ~/project1_files]$ ls -l permissions_test.txt group_test.txt",
      "-rw-r--r--. 1 shuaib shuaib 0 Nov 3 02:32 group_test.txt",
      "-rw-r--r--. 1 shuaib shuaib 0 Nov 3 02:32 permissions_test.txt",
      "[shuaib@linux-project1 ~/project1_files]$ sudo chown student1:project1_group permissions_test.txt",
      "[shuaib@linux-project1 ~/project1_files]$ sudo chgrp project1_group group_test.txt",
      "[shuaib@linux-project1 ~/project1_files]$ ls -l permissions_test.txt group_test.txt",
      "-rw-r--r--. 1 shuaib project1_group 0 Nov 3 02:32 group_test.txt",
      "-rw-r--r--. 1 student1 project1_group 0 Nov 3 02:32 permissions_test.txt",
      "[shuaib@linux-project1 ~/project1_files]$ sudo chmod u+rw permissions_test.txt",
      "[shuaib@linux-project1 ~/project1_files]$ sudo chmod o-w permissions_test.txt",
      "[shuaib@linux-project1 ~/project1_files]$ sudo chmod 640 group_test.txt",
      "[shuaib@linux-project1 ~/project1_files]$ stat -c '%A (%a) owner=%U group=%G %n' permissions_test.txt group_test.txt",
      "-rw-r--r-- (644) owner=student1 group=project1_group permissions_test.txt",
      "-rw-r----- (640) owner=shuaib group=project1_group group_test.txt",
      "[shuaib@linux-project1 ~/project1_files]$ cat permissions_test.txt"
    ],
    "sha256": "a4a52ed15a9c140f892791222afe0358f71395510d45382af54deac4e3acc83d"
  },
  "labs/ad-troubleshooting/07-add-computer-failure.png": {
    "title": "PowerShell / failed domain join",
    "lines": [
      "PS C:\\WINDOWS\\system32> Add-Computer -DomainName lab.local -Credential LAB\\Administrator -Verbose -Restart",
      "VERBOSE: Performing the operation \"Join in domain 'lab.local'\" on target \"DESKTOP-IO53IGD\".",
      "Add-Computer : Computer 'DESKTOP-IO53IGD' failed to join domain 'lab.local' from its current workgroup 'WORKGROUP'",
      "with following error message: The specified domain either does not exist or could not be contacted.",
      "At line:1 char:1",
      "+ CategoryInfo : OperationStopped: (DESKTOP-IO53IGD:String) [Add-Computer], InvalidOperationException",
      "+ FullyQualifiedErrorId : FailToJoinDomainFromWorkgroup,Microsoft.PowerShell.Commands.AddComputerCommand"
    ],
    "sha256": "7524687fcf6c9a7db20f6843eeb063252277b523cb4bc833aeefc3f7d7a8b915"
  },
  "labs/ad-troubleshooting/02-ad-group-membership-powershell.png": {
    "title": "PowerShell / AD group design",
    "lines": [
      "PS C:\\Users\\Administrator> Get-ADUser -Filter 'SamAccountName -eq \"faraz\" -or SamAccountName -like \"employ*\"' |",
      ">> ForEach-Object {",
      ">>     [PSCustomObject]@{",
      ">>         User = $_.SamAccountName",
      ">>         Groups = (Get-ADPrincipalGroupMembership $_ |",
      ">>             Select-Object -ExpandProperty Name) -join \", \"",
      ">>     }",
      ">> } | Format-Table -AutoSize",
      "User          Groups",
      "----          ------",
      "faraz         Domain Users, Forti_Guests",
      "employee_test Domain Users"
    ],
    "sha256": "1137fc6cc91d0a30ddcee14728f74869ec546f639c1227c054c32ebbc7d64e9d"
  },
  "labs/ad-troubleshooting/08-domain-login-success.png": {
